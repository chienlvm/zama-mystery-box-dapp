################################################################################
# Mystery Box DApp - Environment Configuration Template
# Architecture: Frontend (React) -> Relayer Service -> Smart Contracts (FHEVM)
################################################################################

#############################################
# 1. NETWORK & RPC CONFIGURATION
#############################################
# Primary RPC endpoint for Sepolia testnet (Infura, Alchemy, or custom)
# Used by: ALL scripts (hardhat.config.js, relayer.js, grantRoles.js, simulatePurchase.js)
SEPOLIA_RPC_URL=

# Aliases (optional - scripts check these as fallbacks):
# SEPOLIA_RPC=<same as above>           # Used by: relayer.js fallback
# ZAMA_PROVIDER_URL=<same as above>    # Used by: relayer.js, simulatePurchase.js, grantRoles.js fallback

# Zama FHE Relayer SDK Configuration
# Used by: relayer.js
ZAMA_RELAYER_USE_SEPOLIA=true
RELAYER_URL=http://relayer.testnet.zama.org/

# Aliases (optional):
# RELAYER_RELAY_URL=<same as above>    # Used by: relayer.js fallback
# RELAYER_ENDPOINT=<same as above>     # Used by: relayer.js fallback
# USE_SEPOLIA=<true/false>             # Used by: relayer.js fallback


#############################################
# 2. DEPLOYED CONTRACT ADDRESSES
#############################################
# MysteryBox contract address (REQUIRED after deployment)
# Used by: relayer.js, simulatePurchase.js, grantRoles.js
BOX_ADDRESS=

# Aliases (optional - scripts check these as fallbacks):
# ZAMA_CONTRACT_ADDRESS=<same as above>  # Used by: simulatePurchase.js fallback

# MysteryNFT contract address (AUTO-READ from MysteryBox.nft())
# Scripts auto-query this via box.nft(), no need to set unless debugging
# NFT_ADDRESS=0xYOUR_NFT_CONTRACT_ADDRESS


#############################################
# 3. ACCOUNT PRIVATE KEYS
#############################################
# These private keys are used by different scripts based on their role:
#
# ┌─────────────────────┬─────────────────────────────────────────────────────┐
# │ Script              │ Key Usage (in priority order)                       │
# ├─────────────────────┼─────────────────────────────────────────────────────┤
# │ hardhat.config.js   │ DEPLOYER_PRIVATE_KEY                                │
# │ grantRoles.js       │ Admin: DEPLOYER_PRIVATE_KEY or PRIVATE_KEY          │
# │                     │ Relayer: RELAYER_PRIVATE_KEY (to grant role to)     │
# │ relayer.js          │ PRIVATE_KEY or RELAYER_PRIVATE_KEY or DEPLOYER_*    │
# │ simulatePurchase.js │ Buyer: PRIVATE_KEY or RELAYER_* or DEPLOYER_*       │
# │                     │ OpenBox: RELAYER_PRIVATE_KEY or RELAYER_KEY         │
# └─────────────────────┴─────────────────────────────────────────────────────┘

# --- DEPLOYER/ADMIN ACCOUNT ---
# Role: DEFAULT_ADMIN_ROLE on MysteryBox and MysteryNFT
# Used by: hardhat deploy, grantRoles.js (to grant roles)
# Can: deploy contracts, grant/revoke roles, setBox(), withdraw()
DEPLOYER_PRIVATE_KEY=

# --- RELAYER SERVICE ACCOUNT ---
# Role: RELAYER_ROLE on MysteryBox (must be granted by admin)
# Used by: relayer.js (to call openBox/fulfill), simulatePurchase.js (to call openBox)
# Can: call openBox(), fulfillDecryption(), fulfillDecryptionWithProof()
RELAYER_PRIVATE_KEY=

# --- GENERIC/FALLBACK ACCOUNT ---
# Used by: scripts as fallback when specific keys not found
# Can be: same as DEPLOYER or a separate test account
PRIVATE_KEY=

# Aliases (optional):
# RELAYER_KEY=<same as RELAYER_PRIVATE_KEY>  # Used by: simulatePurchase.js fallback


#############################################
# 4. USER/FRONTEND ACCOUNTS (MetaMask)
#############################################
# These accounts simulate end-users interacting via MetaMask frontend
# Used for: testing buyBox(), viewing purchases, receiving NFTs
# NOTE: In production, users connect their own MetaMask - these are test-only

# Test user account 1 (simulates a buyer)
# Use this in simulatePurchase.js by setting PRIVATE_KEY=<this value>
METAMASK_USER1_PRIVATE_KEY=



################################################################################
# SCRIPT-TO-VARIABLE MAPPING (Quick Reference)
################################################################################
#
# hardhat.config.js:
#   networks.sepolia.url      → SEPOLIA_RPC_URL
#   networks.sepolia.accounts → [DEPLOYER_PRIVATE_KEY]
#
# scripts/grantRoles.js:
#   RPC                       → SEPOLIA_RPC_URL || ZAMA_PROVIDER_URL
#   admin wallet              → DEPLOYER_PRIVATE_KEY || PRIVATE_KEY
#   relayer to grant          → RELAYER_PRIVATE_KEY
#   BOX_ADDRESS               → BOX_ADDRESS || deployments.json
#
# scripts/relayer.js:
#   RPC                       → SEPOLIA_RPC || SEPOLIA_RPC_URL
#   wallet                    → PRIVATE_KEY || RELAYER_PRIVATE_KEY || DEPLOYER_PRIVATE_KEY
#   BOX_ADDRESS               → BOX_ADDRESS || deployments.json
#   SDK config                → ZAMA_RELAYER_USE_SEPOLIA, RELAYER_URL, ZAMA_PROVIDER_URL
#
# scripts/simulatePurchase.js:
#   RPC                       → SEPOLIA_RPC || SEPOLIA_RPC_URL || ZAMA_PROVIDER_URL
#   buyer wallet              → PRIVATE_KEY || RELAYER_PRIVATE_KEY || DEPLOYER_PRIVATE_KEY
#   relayer wallet (openBox)  → RELAYER_PRIVATE_KEY || RELAYER_KEY
#   BOX_ADDRESS               → BOX_ADDRESS || ZAMA_CONTRACT_ADDRESS || deployments.json
#
################################################################################


################################################################################
# ON-CHAIN ROLE MAPPING
################################################################################
#
# Contract: MysteryBox.sol
#   ├─ DEFAULT_ADMIN_ROLE = 0x00...00
#   │   └─ Granted to: msg.sender (deployer) in constructor
#   │   └─ Can do: grantRole(), revokeRole(), setBox(), withdraw()
#   │   └─ Key: DEPLOYER_PRIVATE_KEY
#   │
#   └─ RELAYER_ROLE = keccak256("RELAYER_ROLE")
#       └─ Granted to: msg.sender in constructor, then to relayer via grantRoles.js
#       └─ Can do: openBox(), fulfillDecryption(), fulfillDecryptionWithProof()
#       └─ Key: RELAYER_PRIVATE_KEY
#
# Contract: MysteryNFT.sol
#   ├─ DEFAULT_ADMIN_ROLE = 0x00...00
#   │   └─ Granted to: msg.sender (deployer) in constructor
#   │   └─ Can do: grantRole(), revokeRole()
#   │   └─ Key: DEPLOYER_PRIVATE_KEY
#   │
#   └─ MINTER_ROLE = keccak256("MINTER_ROLE")
#       └─ Granted to: msg.sender in constructor, then to MysteryBox via grantRoles.js
#       └─ Can do: safeMint()
#       └─ Address: BOX_ADDRESS (contract address, not a key)
#
################################################################################


################################################################################
# ACCOUNT ROLES & USAGE
################################################################################
#
# ┌──────────────────────┬─────────────────────┬────────────────────────────┐
# │ Account Type         │ Private Key Var     │ On-Chain Role              │
# ├──────────────────────┼─────────────────────┼────────────────────────────┤
# │ Deployer/Admin       │ DEPLOYER_PRIVATE_   │ DEFAULT_ADMIN_ROLE on both │
# │                      │ KEY                 │ MysteryBox & MysteryNFT    │
# ├──────────────────────┼─────────────────────┼────────────────────────────┤
# │ Relayer Service      │ RELAYER_PRIVATE_    │ RELAYER_ROLE on MysteryBox │
# │                      │ KEY                 │                            │
# ├──────────────────────┼─────────────────────┼────────────────────────────┤
# │ MysteryBox Contract  │ (N/A - contract)    │ MINTER_ROLE on MysteryNFT  │
# ├──────────────────────┼─────────────────────┼────────────────────────────┤
# │ Test User (MetaMask) │ METAMASK_USER1_*    │ None (regular user)        │
# │                      │ METAMASK_USER2_*    │                            │
# └──────────────────────┴─────────────────────┴────────────────────────────┘
#
################################################################################


################################################################################
# TESTING WORKFLOW
################################################################################
#
# Step 1: Setup environment
#   cp .env.template .env
#   # Fill in SEPOLIA_RPC_URL, DEPLOYER_PRIVATE_KEY, RELAYER_PRIVATE_KEY, BOX_ADDRESS
#
# Step 2: Deploy contracts (if not deployed)
#   npx hardhat compile
#   npx hardhat run scripts/deploy.js --network sepolia
#   # Update BOX_ADDRESS in .env with deployed address
#
# Step 3: Grant roles (REQUIRED after deployment)
#   node scripts/grantRoles.js
#   # This grants RELAYER_ROLE to relayer and MINTER_ROLE to MysteryBox
#
# Step 4: Test user flow
#   # Option A: Buy only (let relayer service process)
#   node scripts/simulatePurchase.js
#   # Buys box with METAMASK_USER1_PRIVATE_KEY
#   # Waits for relayer service to auto-process
#
#   # Option B: Buy + immediate open (full flow test)
#   node scripts/simulatePurchase.js --auto-open
#   # OR set: AUTO_OPEN_BOX=true
#   # Buys box AND immediately opens it (test mode with mock encryption)
#
# Step 5: Start relayer service (for production/live testing)
#   node scripts/relayer.js
#   # Listens for BoxPurchased events and auto-processes openBox/fulfill
#   # Uses proper FHE encryption and Zama KMS decryption
#
################################################################################


################################################################################
# TESTING OPTIONS
################################################################################
# Auto-open box after purchase (for testing full flow immediately)
# Used by: simulatePurchase.js
# - false (default): Buy only, wait for relayer service
# - true: Buy + immediate open (test mode, no real FHE encryption)
# AUTO_OPEN_BOX=false

# Can also use command line flag:
#   node scripts/simulatePurchase.js --auto-open
#
################################################################################



# Zama FHE Configuration (Browser)
# Reference: https://docs.zama.org/protocol/relayer-sdk-guides/development-guide/webapp

# Sepolia RPC endpoint (public or private)
VITE_SEPOLIA_RPC_URL=

# Zama Relayer endpoint for Sepolia testnet
VITE_RELAYER_URL=http://relayer.testnet.zama.org/

# Contract addresses (after deployment)
VITE_BOX_ADDRESS=
VITE_NFT_ADDRESS=

PINATA_API_KEY=
PINATA_API_SECRET=

#############################################
# 5. PRODUCTION CONFIGURATION
#############################################
# Frontend URL for CORS (Vercel deployment)
# Add your production frontend URL here
FRONTEND_URL=https://zama-mystery-box-dapp.vercel.app

# Node environment
NODE_ENV=production

# API Server Port (Railway/Render auto-sets this)
PORT=3001